# Public origin of the site, used for canonical URLs, the sitemap and share cards
NEXT_PUBLIC_SITE_URL=https://transferlinkz.com

# Postgres connection for the waitlist. Put the real values in .env.local (never
# commit it). DATABASE_URL is the live site's limited user (it can only insert
# signups). DATABASE_MIGRATE_URL is the owner user, used only by the purplekit
# commands (`npm run db:migrate`). See db/setup-roles.sql. Add "?sslmode=require" if the
# host needs SSL.
DATABASE_URL=postgres://transferlinkz_web:password@localhost:5432/waitlist
DATABASE_MIGRATE_URL=postgres://transferlinkz_owner:password@localhost:5432/waitlist

# Only for hosts with their own certificate authority (Aiven, for example): the
# CA certificate text from the host's console. Use "\n" for line breaks if the
# value has to fit on one line.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
