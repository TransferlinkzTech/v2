# Public origin of the site, used for canonical URLs, the sitemap and share cards
NEXT_PUBLIC_SITE_URL=https://transferlinkz.com

# Postgres connection for the waitlist. Put the real values in .env.local (never
# commit it). DATABASE_URL is the live site's limited user (it can only insert
# signups). DATABASE_MIGRATE_URL is the owner user, used only by the purplekit
# commands (`npm run db:migrate`). See db/setup-roles.sql. Add "?sslmode=require" if the
# host needs SSL.
DATABASE_URL=postgres://transferlinkz_web:password@localhost:5432/waitlist
DATABASE_MIGRATE_URL=postgres://transferlinkz_owner:password@localhost:5432/waitlist

# Only for hosts with their own certificate authority (Aiven, for example): the
# CA certificate text from the host's console. Use "\n" for line breaks if the
# value has to fit on one line.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Email goes out through Zoho Mail's SMTP server (see lib/mail/send-email.ts):
# the waitlist thank-you, and the contact form's message to the team and reply
# to the visitor.
# Use smtp.zoho.eu for an EU account (transferlinkz.com's mail is on zoho.eu),
# smtp.zoho.com for a US one. Port 465 is SSL; 587 is STARTTLS.
ZOHO_MAIL_SMTP_HOST=smtp.zoho.eu
ZOHO_MAIL_SMTP_PORT=465
# The mailbox that signs in, and its password (an app-specific password if the
# account has two-factor authentication)
ZOHO_MAIL_USER=
ZOHO_MAIL_PASSWORD=
# Who the emails are sent FROM. Zoho only accepts the mailbox above or one of
# its aliases. Contact messages are sent TO support@transferlinkz.com, and
# replies to visitors' emails go there too.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=TransferLinkz
# Set to 1 to build every email without sending any (for testing)
# MAIL_SANDBOX=1
