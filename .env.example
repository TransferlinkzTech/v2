# Public origin of the site, used for canonical URLs, the sitemap and share cards
NEXT_PUBLIC_SITE_URL=https://transferlinkz.com

# Postgres connection string for the waitlist. Put the real value in .env.local
# (never commit it). Add "?sslmode=require" if the host needs SSL.
DATABASE_URL=postgres://user:password@localhost:5432/transferlinkz
